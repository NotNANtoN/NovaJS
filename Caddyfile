# This is the safe bootstrap configuration. The host updater renders this
# file from /opt/novajs/.env when a hostname and Basic Auth hash are supplied.
:80 {
    @novajs_health path /__novajs_health
    respond @novajs_health 204

    # Internal-testing fallback: HTTP on the IP, without Basic Auth.
    reverse_proxy novajs:8200
}
